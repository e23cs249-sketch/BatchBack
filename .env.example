# Backend settings. Demo mode is the only mode verified without a Db2 service.
DATABASE_MODE=demo
DEMO_STATE_DB=data/batchback-demo-workflow.sqlite3

# Configure only for a separately provisioned Db2 instance and schema.
# No live Db2 connection has been verified for this project.
DB2_DSN=
DB2_UID=
DB2_PWD=

# The application currently uses deterministic rules; these do not enable an LLM.
AI_MODEL=rule-based
ENABLE_AI=false
